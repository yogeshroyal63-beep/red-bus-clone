# Server
PORT=3000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/redbus
# For Atlas: mongodb+srv://username:password@cluster.mongodb.net/redbus

# JWT — CHANGE THIS IN PRODUCTION (min 32 chars, random)
JWT_SECRET=your-super-secret-jwt-key-min-32-characters-long

# CORS
CORS_ORIGINS=http://localhost:4200,https://your-frontend.vercel.app

# Admin access to GET /api/notifications/log — comma-separated user IDs allowed to read it.
# Leave empty to keep the endpoint disabled (503) rather than open.
ADMIN_USER_IDS=

# Route Planner live traffic (Req 4) — TomTom Traffic API.
# Get a free-tier key at https://developer.tomtom.com/user/register
# Leave empty and the app falls back to the deterministic traffic simulation
# it already had (clearly labeled as simulated in the UI when no key is set).
TRAFFIC_API_KEY=
